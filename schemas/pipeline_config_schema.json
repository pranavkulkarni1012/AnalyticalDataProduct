{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adp.company.com/schemas/pipeline_config_schema.json",
  "title": "Analytical Data Product Pipeline Configuration",
  "description": "JSON Schema for validating pipeline configuration YAMLs. This schema is the contract between the Config Generator agent and all downstream agents.",
  "type": "object",
  "required": ["product", "compute", "sources", "transformations", "target", "reconciliation", "runtime"],
  "additionalProperties": false,
  "properties": {
    "product": {
      "type": "object",
      "description": "Product metadata and identification",
      "required": ["name", "domain", "owner", "version", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,50}$",
          "description": "Product name in snake_case (3-51 characters, lowercase)"
        },
        "domain": {
          "type": "string",
          "description": "Business domain (e.g., sales_analytics, finance_analytics)"
        },
        "owner": {
          "type": "string",
          "format": "email",
          "description": "Team or individual email owning this product"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version (e.g., 1.0.0)"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what this product does"
        },
        "tags": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Key-value tags for classification and cost tracking"
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frequency": {
              "type": "string",
              "enum": ["hourly", "daily", "weekly", "monthly"],
              "description": "Execution frequency"
            },
            "cron": {
              "type": "string",
              "description": "Cron expression for scheduling (e.g., '0 6 * * *')"
            }
          }
        }
      }
    },

    "compute": {
      "type": "object",
      "description": "Compute engine selection for ETL execution",
      "required": ["engine"],
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["glue", "emr", "lambda", "ecs"],
          "description": "Compute engine for ETL execution"
        },
        "language": {
          "type": "string",
          "enum": ["pyspark", "python"],
          "description": "Auto-derived: glue/emr -> pyspark, lambda/ecs -> python. Can be set explicitly."
        },
        "tags": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Compute-level tags"
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frequency": {
              "type": "string",
              "enum": ["hourly", "daily", "weekly", "monthly"]
            },
            "cron": {
              "type": "string"
            }
          }
        }
      }
    },

    "sources": {
      "type": "array",
      "description": "Data source definitions (Snowflake only)",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "connection", "database", "schema", "table"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Logical name for this source (used in joins and references)"
          },
          "type": {
            "type": "string",
            "enum": ["snowflake"],
            "description": "Source system type (only Snowflake is supported)"
          },
          "connection": {
            "type": "object",
            "description": "Snowflake connection parameters",
            "required": ["account", "warehouse", "role", "authenticator"],
            "additionalProperties": false,
            "properties": {
              "account": {
                "type": "string",
                "description": "Snowflake account identifier (e.g., company-prod.us-east-1)"
              },
              "warehouse": {
                "type": "string",
                "description": "Snowflake warehouse name"
              },
              "role": {
                "type": "string",
                "description": "Snowflake role for access control"
              },
              "authenticator": {
                "type": "string",
                "enum": ["oauth"],
                "description": "Authentication method (only OAuth is supported)"
              },
              "proxy": {
                "type": "object",
                "description": "Corporate proxy configuration",
                "required": ["http_proxy", "https_proxy"],
                "additionalProperties": false,
                "properties": {
                  "http_proxy": {
                    "type": "string",
                    "description": "HTTP proxy URL"
                  },
                  "https_proxy": {
                    "type": "string",
                    "description": "HTTPS proxy URL"
                  }
                }
              }
            }
          },
          "database": {
            "type": "string",
            "description": "Snowflake database name"
          },
          "schema": {
            "type": "string",
            "description": "Snowflake schema name"
          },
          "table": {
            "type": "string",
            "description": "Snowflake table name"
          },
          "columns": {
            "oneOf": [
              {
                "type": "string",
                "const": "*",
                "description": "Select all columns"
              },
              {
                "type": "array",
                "items": { "type": "string" },
                "description": "Specific column names to select"
              }
            ],
            "description": "Columns to read from the source table"
          },
          "filters": {
            "type": "array",
            "items": { "type": "string" },
            "description": "SQL WHERE clause conditions applied at source"
          }
        }
      }
    },

    "transformations": {
      "type": "object",
      "description": "Data transformation definitions",
      "additionalProperties": false,
      "properties": {
        "joins": {
          "type": "array",
          "description": "Join definitions between source tables",
          "items": {
            "type": "object",
            "required": ["left", "right", "keys", "type"],
            "additionalProperties": false,
            "properties": {
              "left": {
                "type": "string",
                "description": "Left table name (matches a source name)"
              },
              "right": {
                "type": "string",
                "description": "Right table name (matches a source name)"
              },
              "keys": {
                "type": "array",
                "description": "Join key pairs",
                "items": {
                  "type": "object",
                  "required": ["left_key", "right_key"],
                  "additionalProperties": false,
                  "properties": {
                    "left_key": {
                      "type": "string",
                      "description": "Column name from the left table"
                    },
                    "right_key": {
                      "type": "string",
                      "description": "Column name from the right table"
                    }
                  }
                }
              },
              "type": {
                "type": "string",
                "enum": ["inner", "left", "right", "full"],
                "description": "Join type"
              }
            }
          }
        },
        "aggregations": {
          "type": "array",
          "description": "Aggregation definitions",
          "items": {
            "type": "object",
            "required": ["group_by", "metrics"],
            "additionalProperties": false,
            "properties": {
              "group_by": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Columns to group by (can include expressions)"
              },
              "metrics": {
                "type": "array",
                "description": "Aggregate metric definitions",
                "items": {
                  "type": "object",
                  "required": ["column", "function", "alias"],
                  "additionalProperties": false,
                  "properties": {
                    "column": {
                      "type": "string",
                      "description": "Source column for the aggregation"
                    },
                    "function": {
                      "type": "string",
                      "enum": ["sum", "count", "avg", "min", "max", "count_distinct"],
                      "description": "Aggregation function"
                    },
                    "alias": {
                      "type": "string",
                      "description": "Output column name for this metric"
                    }
                  }
                }
              }
            }
          }
        },
        "filters": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Post-transformation filter conditions"
        },
        "column_mappings": {
          "type": "array",
          "description": "Column renaming and expression mappings",
          "items": {
            "type": "object",
            "required": ["source", "target"],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "description": "Source column or expression"
              },
              "target": {
                "type": "string",
                "description": "Target column name"
              },
              "expression": {
                "type": "string",
                "description": "SQL expression for the mapping"
              }
            }
          }
        },
        "custom_sql": {
          "type": "array",
          "description": "Custom SQL transformations",
          "items": {
            "type": "object",
            "required": ["name", "sql"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Name identifier for this SQL block"
              },
              "sql": {
                "type": "string",
                "description": "SQL statement to execute"
              },
              "description": {
                "type": "string",
                "description": "Human-readable description of this SQL block"
              }
            }
          }
        }
      }
    },

    "target": {
      "type": "object",
      "description": "Output target definition (Iceberg table)",
      "required": ["catalog", "database", "table", "s3_path", "write_mode"],
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "type": "string",
          "const": "glue_catalog",
          "description": "Catalog type (only glue_catalog is supported)"
        },
        "database": {
          "type": "string",
          "description": "Target database name in the Glue Catalog"
        },
        "table": {
          "type": "string",
          "description": "Target table name"
        },
        "s3_path": {
          "type": "string",
          "pattern": "^s3://",
          "description": "S3 path for Iceberg table data"
        },
        "format": {
          "type": "string",
          "const": "iceberg",
          "description": "Table format (only Iceberg is supported)"
        },
        "write_mode": {
          "type": "string",
          "enum": ["append", "overwrite"],
          "description": "Write mode for the target table"
        },
        "partition_by": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Partition columns"
        },
        "sort_order": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sort order columns within partitions"
        },
        "table_properties": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Iceberg table properties"
        }
      }
    },

    "reconciliation": {
      "type": "object",
      "description": "Source-to-target reconciliation configuration",
      "required": ["rules"],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether reconciliation is enabled"
        },
        "rules": {
          "type": "array",
          "description": "Reconciliation rule definitions",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type", "source_expr", "target_expr", "tolerance_pct"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Rule name identifier"
              },
              "type": {
                "type": "string",
                "enum": ["row_count", "sum", "distinct_count", "null_check"],
                "description": "Reconciliation check type"
              },
              "source_expr": {
                "type": "string",
                "description": "SQL expression to evaluate against the source"
              },
              "target_expr": {
                "type": "string",
                "description": "SQL expression to evaluate against the target"
              },
              "tolerance_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Acceptable percentage difference (0 = exact match)"
              }
            }
          }
        }
      }
    },

    "data_quality": {
      "type": "object",
      "description": "Data quality check definitions",
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "description": "Data quality check definitions",
          "items": {
            "type": "object",
            "required": ["name", "type", "column"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Check name identifier"
              },
              "type": {
                "type": "string",
                "enum": ["not_null", "unique", "range", "regex", "custom"],
                "description": "Data quality check type"
              },
              "column": {
                "type": "string",
                "description": "Column to check"
              },
              "parameters": {
                "type": "object",
                "description": "Check-specific parameters (e.g., min/max for range, pattern for regex)"
              }
            }
          }
        }
      }
    },

    "runtime": {
      "type": "object",
      "description": "Engine-specific runtime configuration. Required fields vary by compute.engine.",
      "required": ["timeout_minutes"],
      "properties": {
        "timeout_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2880,
          "description": "Maximum execution time in minutes"
        },
        "max_concurrent_runs": {
          "type": "integer",
          "default": 1,
          "description": "Maximum number of concurrent runs"
        },
        "tags": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Runtime tags for resource tracking"
        },

        "glue_version": {
          "type": "string",
          "enum": ["4.0"],
          "description": "Glue version (Glue engine only)"
        },
        "worker_type": {
          "type": "string",
          "enum": ["G.1X", "G.2X", "G.4X", "G.8X", "Z.2X"],
          "description": "Glue worker type (Glue engine only)"
        },
        "num_workers": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100,
          "description": "Number of Glue workers (Glue engine only)"
        },
        "extra_py_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional Python files/wheels (S3 paths, Glue engine only)"
        },
        "extra_jars": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional JAR files (S3 paths, Glue engine only)"
        },
        "job_parameters": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Additional Glue job parameters (Glue engine only)"
        },

        "emr_release": {
          "type": "string",
          "pattern": "^emr-\\d+\\.\\d+\\.\\d+$",
          "description": "EMR release label (EMR engine only)"
        },
        "emr_mode": {
          "type": "string",
          "enum": ["serverless", "ec2"],
          "default": "serverless",
          "description": "EMR execution mode (EMR engine only)"
        },
        "emr_application_id": {
          "type": "string",
          "description": "EMR Serverless application ID (EMR engine, serverless mode)"
        },
        "instance_type": {
          "type": "string",
          "description": "EC2 instance type (EMR engine, ec2 mode)"
        },
        "instance_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Number of instances (EMR engine, ec2 mode)"
        },
        "spark_submit_parameters": {
          "type": "string",
          "description": "Additional spark-submit arguments (EMR engine only)"
        },

        "lambda_memory_mb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 10240,
          "description": "Lambda memory allocation in MB (Lambda engine only)"
        },
        "lambda_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900,
          "description": "Lambda timeout in seconds (Lambda engine only)"
        },
        "python_runtime": {
          "type": "string",
          "enum": ["python3.11", "python3.12"],
          "default": "python3.11",
          "description": "Python runtime version (Lambda engine only)"
        },
        "lambda_layers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Lambda layer ARNs (Lambda engine only)"
        },
        "lambda_package_type": {
          "type": "string",
          "enum": ["zip", "image"],
          "default": "zip",
          "description": "Lambda deployment package type (Lambda engine only)"
        },

        "ecs_cpu": {
          "type": "integer",
          "enum": [256, 512, 1024, 2048, 4096],
          "description": "Fargate CPU units (ECS engine only)"
        },
        "ecs_memory": {
          "type": "integer",
          "minimum": 512,
          "maximum": 30720,
          "description": "Fargate memory in MB (ECS engine only)"
        },
        "container_image": {
          "type": "string",
          "description": "ECR image URI for pre-built container (ECS engine only)"
        },
        "ecs_task_role": {
          "type": "string",
          "description": "IAM role ARN for the ECS task (ECS engine only)"
        },
        "ecs_cluster": {
          "type": "string",
          "description": "ECS cluster name (ECS engine only, uses shared cluster if omitted)"
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "required": ["compute"],
        "properties": {
          "compute": {
            "required": ["engine"],
            "properties": { "engine": { "const": "glue" } }
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "required": ["timeout_minutes", "glue_version", "worker_type", "num_workers"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["compute"],
        "properties": {
          "compute": {
            "required": ["engine"],
            "properties": { "engine": { "const": "emr" } }
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "required": ["timeout_minutes", "emr_release", "emr_mode"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["compute"],
        "properties": {
          "compute": {
            "required": ["engine"],
            "properties": { "engine": { "const": "lambda" } }
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "required": ["timeout_minutes", "lambda_memory_mb", "lambda_timeout_seconds"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["compute"],
        "properties": {
          "compute": {
            "required": ["engine"],
            "properties": { "engine": { "const": "ecs" } }
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "required": ["timeout_minutes", "ecs_cpu", "ecs_memory"]
          }
        }
      }
    }
  ]
}
